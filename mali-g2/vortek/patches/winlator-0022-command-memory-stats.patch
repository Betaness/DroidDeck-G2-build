+/* [mali-g2] VORTEK_CMD_RELEASE_STATS / _LOG=2 (winlator-0022): the connection's pools, then the
+ * process's heap: Scudo's allocated bytes and its secondary (large block) mappings. */
+static void commandMemoryStats(VkContext* context) {
+    CmdMem* m = context->commandMemory;
+    if (!m || !m->statsEvery || !cmdmem_stats_due(m)) return;
+    char tag[32];
+    snprintf(tag, sizeof(tag), "conn %p", (void*)context);
+    cmdmem_log_stats(m, tag);
+    struct mallinfo mi = mallinfo();
+    unsigned secondary = 0, maps = 0;
+    unsigned long secondaryKb = 0;
+    FILE* f = fopen("/proc/self/maps", "r");
+    if (f) {
+        char line[512];
+        while (fgets(line, sizeof(line), f)) {
+            maps++;
+            unsigned long start, end;
+            if (strstr(line, "scudo:secondary") && sscanf(line, "%lx-%lx", &start, &end) == 2) {
+                secondary++;
+                secondaryKb += (end - start) >> 10;
+            }
+        }
+        fclose(f);
+    }
+    println("vortek: command memory stats %s: heap %.1f MiB allocated, %u scudo:secondary maps (%.1f MiB), %u maps", tag,
+            mi.uordblks / 1048576.0, secondary, secondaryKb / 1024.0, maps);
+}
