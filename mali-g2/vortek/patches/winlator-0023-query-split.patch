+/* The side command buffer `which` of `b`, begun for its current recording; NULL if it cannot be had. */
+static VkCommandBuffer querySplitSide(VkContext* context, QuerySplit* q, QsBuffer* b, int which) {
+    QsPool* p = &q->pools[b->pool];
