+static bool querySplitMovable(int requestCode) {
+    return qs_movable(requestCode, REQUEST_CODE_VK_CMD_WRITE_TIMESTAMP, REQUEST_CODE_VK_CMD_WRITE_TIMESTAMP2, REQUEST_CODE_VK_CMD_RESET_QUERY_POOL,
+                      REQUEST_CODE_VK_CMD_COPY_QUERY_POOL_RESULTS);
+}
