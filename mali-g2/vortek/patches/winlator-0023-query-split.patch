+/* [mali-g2] VORTEK_QUERY_SPLIT=1 (winlator-0023, src/query_split.h): timestamps, query resets and query
+ * copies that come before the first or after the last other command of a primary command buffer are
+ * recorded into a command buffer of the server's own pool and submitted right before or after it, so
+ * that the application's pool never holds a query (the Mali then keeps nothing for its renderings).
+ * VORTEK_QUERY_SPLIT_LOG=1 logs the side pools and every 4096th split recording. */
+static int querySplitEnabled(void) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("VORTEK_QUERY_SPLIT");
+        enabled = value && *value == '1';
+        if (enabled) println("vortek: query commands at the start and end of command buffers go to command buffers of their own (VORTEK_QUERY_SPLIT=1)");
+    }
+    return enabled;
+}
