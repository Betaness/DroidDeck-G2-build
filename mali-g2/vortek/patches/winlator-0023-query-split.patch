+/* Replays one movable query command (header at `command`) into a side command buffer: the serialized
+ * arguments start with a presence byte and the command buffer's id, which is swapped for the side one. */
+static bool querySplitRecord(VkContext* context, QuerySplit* q, QsBuffer* b, int which, int requestCode, char* command, int size) {
+    uint64_t id = 0;
+    if (size < 1 + VK_HANDLE_BYTE_COUNT || !command[HEADER_SIZE]) return false;
+    memcpy(&id, command + HEADER_SIZE + 1, sizeof(id));
+    if (id != b->key) return false;
+    VkCommandBuffer side = querySplitSide(context, q, b, which);
+    if (!side) return false;
+    char* args = vt_alloc(&context->memoryPool, size);
+    memcpy(args, command + HEADER_SIZE, size);
+    id = (uint64_t)side;
+    memcpy(args + 1, &id, sizeof(id));
+    HandleRequestFunc handleRequestFunc = getHandleRequestFunc(requestCode);
+    char* saved = context->inputBuffer;
+    context->inputBuffer = args;
+    if (handleRequestFunc) handleRequestFunc(context);
+    context->inputBuffer = saved;
+    q->moved[which]++;
+    return true;
+}
