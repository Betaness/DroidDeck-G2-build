+static const VkCommandBuffer* querySplitExpand(VkContext* context, uint32_t count, const VkCommandBuffer* buffers, uint32_t* outCount) {
+    QuerySplit* q = context->querySplit;
+    *outCount = count;
+    if (!q || !count) return buffers;
+    uint32_t extra = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        QsBuffer* b = qs_buffer(q, (uint64_t)buffers[i]);
+        if (b) extra += qs_side_live(q, b, QS_LEAD) + qs_side_live(q, b, QS_TRAIL);
+    }
+    if (!extra) return buffers;
+    VkCommandBuffer* out = vt_alloc(&context->memoryPool, (count + extra) * sizeof(VkCommandBuffer));
+    uint32_t n = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        QsBuffer* b = qs_buffer(q, (uint64_t)buffers[i]);
+        if (b && qs_side_live(q, b, QS_LEAD)) out[n++] = (VkCommandBuffer)b->side[QS_LEAD];
+        out[n++] = buffers[i];
+        if (b && qs_side_live(q, b, QS_TRAIL)) out[n++] = (VkCommandBuffer)b->side[QS_TRAIL];
+    }
+    q->submitsExpanded++;
+    *outCount = n;
+    return out;
+}
