+            p->failed = true;
+            println("vortek: query split: no side command pool for 0x%llx, its queries stay", (unsigned long long)p->key);
+            return VK_NULL_HANDLE;
+        }
+        VkContext_track(context, device, OWNED_COMMAND_POOL, side); /* destroyed with the device if the client goes */
+        p->side = (uint64_t)side;
+        if (q->log) println("vortek: query split: side command pool 0x%llx for 0x%llx", (unsigned long long)p->side, (unsigned long long)p->key);
+    }
+    if (!b->side[which]) {
+        VkCommandBufferAllocateInfo info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, NULL, (VkCommandPool)p->side, VK_COMMAND_BUFFER_LEVEL_PRIMARY, 1};
+        VkCommandBuffer side;
