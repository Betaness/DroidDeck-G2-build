+/* [mali-g2] The Mali driver keeps host memory for every vkCmdBeginRendering recorded into command pool
+ * memory that has held a query since the pool last released (about 420 bytes each,
+ * tests/frame_leak_test.c, cmd_memory.h) until the pool is reset with RELEASE_RESOURCES or destroyed
+ * (or, for single command buffer resets, the buffer is reset that way). DXVK resets its
+ * pools with flags 0, so a game issuing D3D11 queries grew the server by tens of MB a minute until
+ * malloc failed. Resets add RELEASE_RESOURCES:
+ *   - by default when the estimate of what the driver keeps (cmd_memory.h) reaches
+ *     VORTEK_CMD_RELEASE_BYTES for the pool (default 16m) or VORTEK_CMD_RELEASE_TOTAL_BYTES over all
+ *     pools of the connection (default 2 x VORTEK_CMD_RELEASE_BYTES) and the pool (buffer) holds at
+ *     least 1/16 of the smaller limit; pools without queries never release. Implicit resets by
+ *     vkBeginCommandBuffer are covered for pools that allow single resets (an explicit releasing
+ *     vkResetCommandBuffer first). VORTEK_CMD_RELEASE_LOG=1 logs every release (otherwise the first
+ *     four and every 64th).
+ *   - with VORTEK_CMD_RELEASE_EVERY set to a number: every VORTEK_CMD_RELEASE_EVERY-th reset of the
+ *     same pool or command buffer (1 = every reset, 0 = never; a 64-entry table per connection, a new
+ *     or colliding handle releases), the policy before the estimate. Not a number: the estimate. */
+typedef struct CommandReleaseConfig {
+    int every;               /* -1: by the estimate */
+    uint64_t perPool, total;
+    int log;
+} CommandReleaseConfig;
+
+static CommandReleaseConfig commandRelease;
+
+static void readCommandReleaseConfig(void) {
+    const char* value = getenv("VORTEK_CMD_RELEASE_EVERY");
+    commandRelease.every = cmdmem_parse_every(value);
+    if (commandRelease.every >= 0) {
+        println("vortek: VORTEK_CMD_RELEASE_EVERY=%d", commandRelease.every);
+        return;
+    }
+    if (value && *value) println("vortek: VORTEK_CMD_RELEASE_EVERY=%s is not a number, releasing by the estimate", value);
+    commandRelease.perPool = cmdmem_parse_bytes(getenv("VORTEK_CMD_RELEASE_BYTES"), CMDMEM_DEFAULT_PER_POOL);
+    commandRelease.total = cmdmem_parse_bytes(getenv("VORTEK_CMD_RELEASE_TOTAL_BYTES"), CMDMEM_DEFAULT_TOTAL(commandRelease.perPool));
+    const char* log = getenv("VORTEK_CMD_RELEASE_LOG");
+    commandRelease.log = log && *log && *log != '0';
+    println("vortek: command memory released by estimate: %.1f MiB per pool, %.1f MiB in all", commandRelease.perPool / 1048576.0,
+            commandRelease.total / 1048576.0);
+}
+
+static const CommandReleaseConfig* commandReleaseConfig(void) {
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, readCommandReleaseConfig);
+    return &commandRelease;
+}
+
+/* The connection's estimate, created with its first command pool; NULL with VORTEK_CMD_RELEASE_EVERY. */
+static CmdMem* commandMemoryOf(VkContext* context) {
+    const CommandReleaseConfig* config = commandReleaseConfig();
+    if (config->every >= 0) return NULL;
+    if (!context->commandMemory) context->commandMemory = cmdmem_create(config->perPool, config->total, config->log);
+    return context->commandMemory;
+}
+
+static bool releaseCommandMemory(VkContext* context, uint64_t handle) {
+    int every = commandReleaseConfig()->every;
+    if (every < 0) every = CMDMEM_FALLBACK_EVERY; /* the estimate could not be allocated */
+    if (every <= 1) return every == 1;
+    uint32_t slot = (uint32_t)((handle * 0x9E3779B97F4A7C15ull) >> 58);
+    if (context->commandResets[slot].handle != handle) {
+        context->commandResets[slot].handle = handle;
+        context->commandResets[slot].resets = 0;
+        return true;
+    }
+    if (++context->commandResets[slot].resets < (uint32_t)every) return false;
+    context->commandResets[slot].resets = 0;
+    return true;
+}
